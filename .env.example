# ── LIFF frontend ─────────────────────────────────────────────
# LINE Login channel > LIFF app ID (e.g. 1234567890-abcdefgh).
# Leave empty to run the site in mock mode (no LINE login required).
NEXT_PUBLIC_LIFF_ID=

# ── Notion ────────────────────────────────────────────────────
# Internal integration token from https://www.notion.so/my-integrations
NOTION_API_KEY=

# Live (read-only for the app) catalog databases
NOTION_PRODUCTS_LIVE_DB_ID=
NOTION_KNOWLEDGE_LIVE_DB_ID=
NOTION_DELIVERY_LIVE_DB_ID=

# Draft (customer-editable) databases — used by the n8n sync workflows
NOTION_PRODUCTS_DRAFT_DB_ID=
NOTION_KNOWLEDGE_DRAFT_DB_ID=
NOTION_DELIVERY_DRAFT_DB_ID=

# Optional: customers / orders databases
NOTION_CUSTOMERS_DATABASE_ID=
NOTION_ORDERS_DATABASE_ID=

# Ticketing databases
NOTION_TICKETS_DATABASE_ID=
NOTION_LINE_GROUPS_DATABASE_ID=

# ── LINE Messaging API ────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Work group that receives ticket notifications (C + 32 hex chars)
LINE_STORE_GROUP_ID=

# ── n8n ───────────────────────────────────────────────────────
# Workflow A (LINE customer-service agent) production webhook
N8N_WEBHOOK_URL=
# Workflow B (LIFF support ticket) production webhook
N8N_SUPPORT_WEBHOOK_URL=

# ── Local tooling ─────────────────────────────────────────────
LINE_WEBHOOK_TEST_URL=http://localhost:8787/line/webhook
# Base URL of your deployed app, used by the rich-menu builder
RICH_MENU_APP_BASE_URL=
