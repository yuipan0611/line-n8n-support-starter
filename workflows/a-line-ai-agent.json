        "jsonBody": "={\n  \"parent\": { \"database_id\": \"91edd1c75e4e47d5b07542e015a74894\" },\n  \"properties\": {\n    \"工單標題\": { \"title\": [{ \"text\": { \"content\": $json.title } }] },\n    \"狀態\": { \"status\": { \"name\": \"未開始\" } },\n    \"急迫度\": { \"select\": { \"name\": $json.urgency } },\n    \"類型\": { \"select\": { \"name\": $json.topic } },\n    \"來源\": { \"select\": { \"name\": \"LIFF表單\" } },\n    \"LINE User ID\": { \"rich_text\": [{ \"text\": { \"content\": $json.lineUserId } }] },\n    \"客戶名稱\": { \"rich_text\": [{ \"text\": { \"content\": $json.customerName } }] },\n    \"聯絡人\": { \"rich_text\": [{ \"text\": { \"content\": $json.contactPerson } }] },\n    \"電話\": { \"phone_number\": $json.phone || null },\n    \"相關訂單\": { \"rich_text\": [{ \"text\": { \"content\": $json.relatedOrderId } }] },\n    \"問題說明\": { \"rich_text\": [{ \"text\": { \"content\": $json.message } }] },\n    \"到期日\": { \"date\": { \"start\": $json.dueDate } },\n    \"完成通知\": { \"checkbox\": false }\n  }\n}",
        "options": {}
