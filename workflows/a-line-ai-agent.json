    {
      "parameters": {
        "jsCode": "const lineEvent = $json.event || $json.body?.events?.[0] || $json.events?.[0] || $('LINE Webhook').item.json.body?.events?.[0] || $json;\n\nif (lineEvent.type === 'postback' && (lineEvent.postback?.data || '').includes('source=line_ticket_flex')) {\n  return [];\n}\n\nconst source = lineEvent.source || {};\nconst message = lineEvent.message || {};\nconst groupId = source.groupId || source.roomId || '';\nconst isGroup = source.type === 'group' || source.type === 'room';\n\nif (!isGroup || !groupId) {\n  return [];\n}\n\nreturn [{\n  json: {\n    groupId,\n    groupName: source.type === 'group' ? 'LINE 工作群組' : 'LINE Room',\n    groupType: '工作群組',\n    status: '啟用',\n    purposes: ['工單通知', '待辦查詢'],\n    lastMessageAt: lineEvent.timestamp ? new Date(lineEvent.timestamp).toISOString() : new Date().toISOString(),\n    lastMessageSummary: message.text || message.type || '非文字訊息',\n    lastUserId: source.userId || '',\n  },\n}];"
      },
