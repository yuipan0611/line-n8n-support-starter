    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst urgencyMap = { '急件': '急件', '今天需回覆': '今天需回覆', '一般': '一般' };\nconst due = body.urgency === '一般'\n  ? new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString().slice(0, 10)\n  : new Date().toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    requestId: body.requestId,\n    title: `${body.customerName || 'LINE客戶'}｜${body.topic || '人工協助'}`,\n    customerName: body.customerName || '',\n    contactPerson: body.contactPerson || '',\n    phone: body.phone || '',\n    topic: body.topic || '其他',\n    urgency: urgencyMap[body.urgency] || '一般',\n    relatedOrderId: body.relatedOrderId || '',\n    message: body.message || '',\n    lineUserId: body.lineUserId || '',\n    liffUrl: body.liffUrl || '',\n    dueDate: due,\n    workGroupId: $env.LINE_STORE_GROUP_ID || '',\n  },\n}];"
      },
