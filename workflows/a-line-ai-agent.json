    {
      "parameters": {
        "jsCode": "const source = $('Normalize LIFF Support Request').item.json;\nconst notionUrl = $json.url || '';\nconst text = [\n  '新 LIFF 人工工單',\n  `[${source.urgency}] ${source.title}`,\n  `客戶：${source.customerName}`,\n  `聯絡：${source.contactPerson} ${source.phone}`,\n  source.relatedOrderId ? `訂單：${source.relatedOrderId}` : '',\n  `內容：${source.message}`,\n  notionUrl ? `Notion：${notionUrl}` : '',\n].filter(Boolean).join('\\n');\n\nreturn [{\n  json: {\n    to: source.workGroupId,\n    messages: [{ type: 'text', text }],\n    response: { ok: true, requestId: source.requestId, notionUrl },\n  },\n}];"
      },
