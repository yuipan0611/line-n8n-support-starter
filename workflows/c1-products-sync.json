      "id": "94e0a6c5-1a38-42dd-af96-d9fb285eefbc",
      "name": "讀取商品編輯庫(待同步)",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        224,
        -32
      ],
      "credentials": {
        "notionApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Notion API"
        }
      }
