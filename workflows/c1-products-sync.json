    {
      "parameters": {
        "jsCode": "function rich(p){ if(!p) return \"\"; if(p.type===\"title\") return (p.title||[]).map(function(t){return t.plain_text;}).join(\"\"); if(p.type===\"rich_text\") return (p.rich_text||[]).map(function(t){return t.plain_text;}).join(\"\"); return \"\"; }\nfunction sel(p){ return (p && p.select && p.select.name) ? p.select.name : \"\"; }\nfunction num(p){ return (p && typeof p.number === \"number\") ? p.number : null; }\nfunction urlv(p){ return (p && p.url) ? p.url : \"\"; }\nconst allowedCategory = [\"當季水果\",\"進口水果\",\"禮盒組合\",\"學校團膳\",\"公司訂購\"];\nconst allowedStock = [\"有貨\",\"少量\",\"售完\",\"預購\"];\nconst items = $input.all();\nconst skuCount = {};\nfor (const it of items) { const s = rich((it.json.properties||{})[\"編號\"]).trim(); if (s) skuCount[s] = (skuCount[s]||0)+1; }\nconst out = [];\nfor (const it of items) {\n  const props = it.json.properties || {};\n  const name = rich(props[\"商品名稱\"]).trim();\n  const sku = rich(props[\"編號\"]).trim();\n  const category = sel(props[\"分類\"]);\n  const spec = rich(props[\"規格\"]).trim();\n  const unit = rich(props[\"單位\"]).trim();\n  const priceRaw = num(props[\"價格\"]);\n  const stock = sel(props[\"庫存狀態\"]);\n  const imageUrl = urlv(props[\"圖片網址\"]).trim();\n  const sortRaw = num(props[\"排序\"]);\n  const freshness = rich(props[\"鮮度備註\"]);\n  const shelfRaw = sel(props[\"上架狀態\"]);\n  const desc = rich(props[\"說明\"]);\n  const errors = [];\n  if (!sku) errors.push(\"缺少編號\"); else if (skuCount[sku] > 1) errors.push(\"編號重複\");\n  if (!name) errors.push(\"缺少商品名稱\");\n  if (!spec) errors.push(\"缺少規格\");\n  if (!unit) errors.push(\"缺少單位\");\n  if (!category) errors.push(\"缺少分類\"); else if (!allowedCategory.includes(category)) errors.push(\"分類不在允許清單\");\n  const price = (priceRaw === null) ? NaN : Number(priceRaw);\n  if (isNaN(price) || price < 0) errors.push(\"價格必須是數字且大於等於0\");\n  if (stock && !allowedStock.includes(stock)) errors.push(\"庫存狀態不在允許清單\");\n  if (imageUrl && imageUrl.toLowerCase().indexOf(\"http\") !== 0) errors.push(\"圖片網址需以http開頭\");\n  const sortOrder = (typeof sortRaw === \"number\") ? sortRaw : 999;\n  const shelf = (shelfRaw === \"停用\") ? \"停用\" : \"啟用\";\n  out.push({ json: { draftPageId: it.json.id, \"編號\": sku, \"商品名稱\": name, \"分類\": category, \"說明\": desc, \"規格\": spec, \"單位\": unit, \"價格\": isNaN(price) ? 0 : price, \"庫存狀態\": stock || \"有貨\", \"圖片網址\": imageUrl, \"排序\": sortOrder, \"鮮度備註\": freshness, \"上架狀態\": shelf, _valid: errors.length === 0, _error: errors.join(\"、\") } });\n}\nreturn out;"
      },
