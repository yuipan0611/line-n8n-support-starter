      "id": "41256083-f677-4bb8-b2b8-ac8678878d35",
      "name": "讀取知識庫編輯庫(待同步)",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        224,
        0
      ],
      "credentials": {
        "notionApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Notion API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function rich(p){ if(!p) return \"\"; if(p.type===\"title\") return (p.title||[]).map(function(t){return t.plain_text;}).join(\"\"); if(p.type===\"rich_text\") return (p.rich_text||[]).map(function(t){return t.plain_text;}).join(\"\"); return \"\"; }\nfunction sel(p){ return (p && p.select && p.select.name) ? p.select.name : \"\"; }\nconst allowedCategory = [\"商品\",\"FAQ訂購\",\"FAQ配送\",\"FAQ付款\",\"FAQ退換貨\",\"FAQ一般\",\"貼圖\"];\nconst items = $input.all();\nconst skuCount = {};\nfor (const it of items) { const s = rich((it.json.properties||{})[\"編號\"]).trim(); if (s) skuCount[s] = (skuCount[s]||0)+1; }\nconst out = [];\nfor (const it of items) {\n  const props = it.json.properties || {};\n  const title = rich(props[\"標題\"]).trim();\n  const sku = rich(props[\"編號\"]).trim();\n  const category = sel(props[\"分類\"]);\n  const content = rich(props[\"內容\"]).trim();\n  const statusRaw = sel(props[\"狀態\"]);\n  const errors = [];\n  if (!sku) errors.push(\"缺少編號\"); else if (skuCount[sku] > 1) errors.push(\"編號重複\");\n  if (!title) errors.push(\"缺少標題\");\n  if (!content) errors.push(\"缺少內容\");\n  if (!category) errors.push(\"缺少分類\"); else if (!allowedCategory.includes(category)) errors.push(\"分類不在允許清單\");\n  const status = (statusRaw === \"停用\") ? \"停用\" : \"啟用\";\n  out.push({ json: { draftPageId: it.json.id, \"標題\": title, \"編號\": sku, \"分類\": category, \"內容\": content, \"狀態\": status, _valid: errors.length === 0, _error: errors.join(\"、\") } });\n}\nreturn out;"
      },
      "id": "a7376fca-ec2d-4a05-aecf-657393632010",
      "name": "驗證FAQ",
