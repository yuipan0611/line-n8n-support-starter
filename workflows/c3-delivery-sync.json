      "id": "04656595-eb51-4127-95fa-b9b3df837606",
      "name": "讀取配送規則編輯庫(待同步)",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        224,
        0
      ],
      "credentials": {
        "notionApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Notion API"
        }
      }
