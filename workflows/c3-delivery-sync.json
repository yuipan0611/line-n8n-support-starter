    {
      "parameters": {
        "jsCode": "function rich(p){ if(!p) return \"\"; if(p.type===\"title\") return (p.title||[]).map(function(t){return t.plain_text;}).join(\"\"); if(p.type===\"rich_text\") return (p.rich_text||[]).map(function(t){return t.plain_text;}).join(\"\"); return \"\"; }\nfunction sel(p){ return (p && p.select && p.select.name) ? p.select.name : \"\"; }\nfunction num(p){ return (p && typeof p.number === \"number\") ? p.number : null; }\nfunction multiSel(p){ if(!p || !p.multi_select) return []; return p.multi_select.map(function(o){return o.name;}); }\nfunction chk(p){ return !!(p && p.checkbox); }\nconst allowedArea = [\"台中市區\",\"屯區\",\"海線\",\"山線\",\"外縣市\"];\nconst items = $input.all();\nconst skuCount = {};\nfor (const it of items) { const s = rich((it.json.properties||{})[\"編號\"]).trim(); if (s) skuCount[s] = (skuCount[s]||0)+1; }\nconst out = [];\nfor (const it of items) {\n  const props = it.json.properties || {};\n  const name = rich(props[\"規則名稱\"]).trim();\n  const sku = rich(props[\"編號\"]).trim();\n  const area = sel(props[\"區域\"]);\n  const districts = multiSel(props[\"涵蓋行政區\"]);\n  const freeShip = num(props[\"免運門檻\"]);\n  const fee = num(props[\"配送費\"]);\n  const minOrder = num(props[\"最低訂購額\"]);\n  const isActive = chk(props[\"啟用\"]);\n  const notes = rich(props[\"備註\"]);\n  const sortRaw = num(props[\"排序\"]);\n  const errors = [];\n  if (!sku) errors.push(\"缺少編號\"); else if (skuCount[sku] > 1) errors.push(\"編號重複\");\n  if (!name) errors.push(\"缺少規則名稱\");\n  if (!area) errors.push(\"缺少區域\"); else if (!allowedArea.includes(area)) errors.push(\"區域不在允許清單\");\n  if (!districts.length) errors.push(\"涵蓋行政區至少1項\");\n  if (freeShip === null || freeShip < 0) errors.push(\"免運門檻必須是數字且大於等於0\");\n  if (fee === null || fee < 0) errors.push(\"配送費必須是數字且大於等於0\");\n  if (minOrder === null || minOrder < 0) errors.push(\"最低訂購額必須是數字且大於等於0\");\n  const sortOrder = (typeof sortRaw === \"number\") ? sortRaw : 999;\n  out.push({ json: { draftPageId: it.json.id, \"規則名稱\": name, \"編號\": sku, \"區域\": area, \"涵蓋行政區\": districts, \"免運門檻\": freeShip||0, \"配送費\": fee||0, \"最低訂購額\": minOrder||0, \"啟用\": isActive, \"備註\": notes, \"排序\": sortOrder, _valid: errors.length === 0, _error: errors.join(\"、\") } });\n}\nreturn out;"
      },
